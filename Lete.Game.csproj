<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RootNamespace>Lete.Game</RootNamespace>
  </PropertyGroup>

  <!-- O Godot compila todo .cs abaixo da raiz; o Core e os testes entram só por referência. -->
  <ItemGroup>
    <Compile Remove="src/Lete.Core/**" />
    <Compile Remove="src/Lete.Core.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src/Lete.Core/Lete.Core.csproj" />
  </ItemGroup>

</Project>
